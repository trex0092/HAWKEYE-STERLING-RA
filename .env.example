# Hawkeye Sterling — Entity Risk Assessment
# Environment variables required for full functionality.
# Copy to .env (never commit .env) or configure in your hosting dashboard.

# ── Asana integration (required for Netlify functions and GitHub Actions watchdog) ──

# Personal access token from https://app.asana.com/0/developer-console
# Scopes: tasks:read, tasks:write, projects:read
# Used by: netlify/functions/asana-task.js, netlify/functions/risk-backup.js,
#          scripts/fatf-watchdog.mjs, scripts/asana-alert.mjs
ASANA_ACCESS_TOKEN=

# GID of the Asana project where assessment tasks are filed (RISK ASSESSMENTS).
# Find it in the project URL: app.asana.com/0/<GID>/...
# Defaults to 1215653768729951 if not set — set this explicitly to avoid targeting the wrong project.
ASANA_PROJECT_GID=

# Asana user to assign completed assessment tasks to.
# Use "me" (default) for the token bearer, or a user GID from the Asana API.
ASANA_ASSIGNEE=me

# ── Daily customer screening (scripts/sanctions-screen.mjs / Sanctions Screen action) ──

# GID of the Asana "Customer Database" project whose active tasks are the
# counterparties screened daily against the sanctions/watchlists.
# Find it in the project URL. Defaults to the built-in value if not set.
ASANA_CUSTOMER_PROJECT_GID=

# Hawkeye Sterling screening engine — base URL and bearer token. The daily
# Sanctions Screen GitHub Action POSTs the customer batch to
# <HAWKEYE_API_URL><HAWKEYE_SCREEN_PATH> with this key and parses the hits.
# Without both, the screen does NOT run (and never reports a false all-clear) —
# it opens a GitHub issue instead. Add as GitHub Actions repository secrets.
HAWKEYE_API_URL=
HAWKEYE_API_KEY=
# Engine screen endpoint path (default /api/screen) and the score at/above which
# a hit is treated as a material match (default 0.85). Optional.
HAWKEYE_SCREEN_PATH=
SCREEN_MATCH_THRESHOLD=

# ── AI brain (Anthropic) ──

# Anthropic API key that powers the AI features. It never reaches the browser —
# the key lives server-side and is read by:
#   netlify/functions/brain-soul.js  — the Advisor "brain" (live Q&A + Super Tools)
#   scripts/reg-draft.mjs            — the optional AI draft on the Regulatory Watch PR
# Set it in the Netlify environment (for brain-soul) and as a GitHub Actions
# repository secret named ANTHROPIC_API_KEY (for reg-draft). Without it, the
# Advisor reports "brain unavailable" and the Regulatory Watch PR is detection-only.
# Get a key at https://console.anthropic.com/ — already configured in the live env.
ANTHROPIC_API_KEY=

# ── Edge hardening / CORS (optional) ──

# Canonical production origin the Netlify functions accept browser calls from.
# Defaults to https://hawkeye-sterling-ra.netlify.app. Set this to your custom
# domain (e.g. https://app.example.com) so CORS locks to the real site.
PRIMARY_ORIGIN=

# Comma-separated EXTRA browser origins allowed to call the Netlify functions,
# in addition to PRIMARY_ORIGIN. Same-origin and header-less (server-to-server)
# requests are always allowed; any other browser origin is rejected with 403 and
# receives no Access-Control-Allow-Origin header. Leave blank for primary only.
# Example: https://staging--hawkeye-sterling-ra.netlify.app,https://example.com
ALLOWED_ORIGINS=
