# Hawkeye Sterling — Entity Risk Assessment
# Environment variables required for full functionality.
# Copy to .env (never commit .env) or configure in your hosting dashboard.

# ── Asana integration (required for Netlify functions and GitHub Actions watchdog) ──

# Personal access token from https://app.asana.com/0/developer-console
# Scopes: tasks:read, tasks:write, projects:read
# Used by: netlify/functions/asana-task.js, netlify/functions/risk-backup.js,
#          scripts/fatf-watchdog.mjs, scripts/asana-alert.mjs
ASANA_ACCESS_TOKEN=

# GID of the Asana project where assessment tasks are filed (HAWKEYE STERLING APP).
# Find it in the project URL: app.asana.com/1/<workspace>/project/<GID>/...
# Defaults to 1216203370612914 (HAWKEYE STERLING APP) if not set. Set in Netlify env
# for the functions and, if the GitHub Actions watchers should target it too, as the
# ASANA_PROJECT_GID repo variable.
ASANA_PROJECT_GID=1216203370612914

# Asana user to assign completed assessment tasks to.
# Use "me" (default) for the token bearer, or a user GID from the Asana API.
ASANA_ASSIGNEE=me

# Optional — native Asana custom-field GIDs for the RISK ASSESSMENTS project, so a
# completed assessment populates real, filterable/reportable fields (not just the
# task name/notes). Each is applied best-effort AFTER the task exists, so a wrong
# GID never loses the delivery. Leave blank to keep the feature off.
#   Create text custom fields in the project, then paste their GIDs here.
ASANA_CF_REF=            # "Reference" text field  (= the assessment ref)
ASANA_CF_TIER=           # "Risk Tier" text field  (CDD / SDD / EDD / PROHIBITED)
ASANA_CF_SCORE=          # "Score" text field      (numeric risk score)
ASANA_CF_NEXT_REVIEW=    # "Next Review" text field (YYYY-MM-DD)

# Optional — bounded auto-retry for HTTP 429 (rate limit) on the delivery function.
# A 429 means Asana did not process the request, so retrying is safe (5xx is never
# retried, to avoid duplicating a create). Defaults: 2 retries, 2000 ms cap.
ASANA_MAX_RETRIES=2
ASANA_RETRY_CAP_MS=2000

# ── Daily customer screening (scripts/sanctions-screen.mjs / Sanctions Screen action) ──

# GID of the Asana "Customer Database" project whose active tasks are the
# counterparties screened daily against the sanctions/watchlists.
# Find it in the project URL. Defaults to the built-in value if not set.
ASANA_CUSTOMER_PROJECT_GID=

# The daily Sanctions Screen runs entirely inside the GitHub Action — it fetches
# the free consolidated lists (OFAC SDN + non-SDN, UN, EU, UK OFSI, plus any
# source in data/sanctions-sources.json / data/sanctions-extra.json, and the
# maintained UAE EOCN list in data/eocn-local-terrorist-list.json) and matches
# the Asana customer base against them locally (scripts/sanctions-match.mjs).
# No external engine and no API key are required. If every list fails to load the
# screen does NOT run (and never reports a false all-clear) — it opens an issue.
#
# Material-match score, 0-1 (default 0.85). Optional. ONE-WAY: raising it above
# the champion default weakens screening, so a raise is rejected loudly unless
# SCREEN_MATCH_THRESHOLD_ALLOW_RAISE=1 is set as a separate explicit decision
# (docs/governance/champion-challenger-thresholds.md). Lowering is plain config.
SCREEN_MATCH_THRESHOLD=
SCREEN_MATCH_THRESHOLD_ALLOW_RAISE=
# Log-only shadow challenger band, 0-1, must sit below the live threshold
# (e.g. 0.80). Clear subjects whose best score lands in [shadow, threshold) are
# logged and written to the results file's shadow[] array — never an alert,
# never a case. Evidence feed for the champion/challenger decision log. Optional.
SCREEN_SHADOW_THRESHOLD=
# Python engine equivalents (0-100 scale — screen.py validates the range and
# enforces the same one-way rule via MATCH_THRESHOLD_ALLOW_RAISE=1):
#   MATCH_THRESHOLD (85) · MATCH_CORE_THRESHOLD (82) ·
#   MATCH_SHORT_ENTRY_THRESHOLD (97) · MATCH_TOKENSET_THRESHOLD (93) ·
#   SHADOW_THRESHOLD (unset = off; e.g. 80)
# Phonetic fold layer (both engines): 1 = live (default) | shadow = log
# would-be hits, emit none (volume preview) | 0 = off. Invalid values are
# rejected loudly and the default kept. Optional.
MATCH_PHONETIC=
# Transliteration variant cap for name_variants (default 32, validated ≥1).
# The groups themselves live in data/translit-groups.json. Optional.
TRANSLIT_VARIANT_CAP=
# Adverse media (free Google News RSS + GDELT + Bing News) and PEP (free
# Wikidata) signals are ON by default. Set either to 0 to disable. Optional.
SCREEN_ADVERSE_MEDIA=
SCREEN_PEP=
# Articles kept per subject after dedup/ranking (default 8, validated 1-20) and
# Google News locale sweep width (default 8 of the worldwide matrix). Optional.
ADVERSE_MAX_RESULTS=
ADVERSE_LOCALES=

# ── Ongoing Monitoring — Asana audit-trail task (scripts/sanctions-screen.mjs) ──
# Every daily run posts an Adverse Media & PEP task (CLEAR or HIT) to the
# "Ongoing Monitoring" project, so there is always evidence the monitoring
# executed. The section is found/created BY NAME at runtime, so these are
# OPTIONAL — set the section GID only to override the lookup.
ASANA_OM_PROJECT_GID=1213914392047129   # "Ongoing Monitoring" project GID

# ── Screening populations + delivery queues (MLRO-directed, 2026-07-29) ──
# The daily screen reads TWO populations: the Customer Database (customers,
# UBOs, owners) and the HR – Employees project (staff screening). Employee
# screening is on by default; set ASANA_EMPLOYEE_DB_GID empty to disable it
# EXPLICITLY — while configured, an unreachable or empty employee project is
# FATAL, same contract as the customer database (a population that silently
# drops out of screening is a silent clear for everyone in it).
ASANA_EMPLOYEE_DB_GID=1216139945846994
# Daily deliverables are multi-homed into BOTH MLRO queues: Ongoing Monitoring
# (review record) and Follow Ups (action queue) — one task, two projects, one
# audit trail. Set ASANA_FOLLOWUPS_GID empty to deliver to OM only.
ASANA_FOLLOWUPS_GID=1215884707932023
ASANA_FOLLOWUPS_SECTION_GID=1215884707932047

# Coverage floors for the two core lists added 2026-07-29 (Australia DFAT and
# Switzerland SECO, both via the OpenSanctions mirrors). PROVISIONAL and low on
# purpose — the adaptive ratchet below tightens them automatically as history
# accrues. See CORE_LIST_FLOORS in screen.py.
LIST_FLOOR_AU=500
LIST_FLOOR_CH=500
# Adaptive floor ratchet: each run raises (never lowers) a PRIMARY-served core
# list's effective floor to ADAPTIVE_FLOOR_PCT of its trailing-median count
# from data/source-coverage-state.json, once ADAPTIVE_FLOOR_MIN_HISTORY days
# of history exist. Fallback-served lists keep the static floor (a mirror is a
# different corpus). ADAPTIVE_FLOOR_PCT=0 disables the ratchet.
ADAPTIVE_FLOOR_PCT=0.5
ADAPTIVE_FLOOR_MIN_HISTORY=5
# List-download retry: transient failures (network error, 5xx, 429) retry with
# short backoff up to this many attempts; any other 4xx fails immediately so
# the fallback ladder takes over without delay.
DOWNLOAD_ATTEMPTS=3
# Post-delivery coverage-alarm gate (exit 6): a source-coverage drift alarm
# (core list shrank vs trailing median; EOCN mirror designations missing
# locally) turns the run red AFTER the report is delivered, so alerting keyed
# on the run conclusion sees it. Set to 0 to log without failing.
COVERAGE_ALARM_HARD_FAIL=1
ASANA_OM_AM_PEP_SECTION_GID=            # override: "Adverse Media & PEP Monitoring" section GID

# ── Daily AI Governance & Platform Report (scripts/governance-report.mjs) ──
# One task per day in Ongoing Monitoring rolling up the non-AML control suite
# (AI/advisor governance, security scans, CI quality, health, hygiene). The
# section is found/created BY NAME ("AI & Platform Governance") at runtime.
ASANA_GOV_SECTION_GID=                  # override: "AI & Platform Governance" section GID

# ── AI brain (Anthropic) ──

# Anthropic API key that powers the AI features. It never reaches the browser —
# the key lives server-side and is read by:
#   netlify/functions/brain-soul.js  — the Advisor "brain" (live Q&A + Super Tools)
#   scripts/reg-draft.mjs            — the optional AI draft on the Regulatory Watch PR
# Set it in the Netlify environment (for brain-soul) and as a GitHub Actions
# repository secret named ANTHROPIC_API_KEY (for reg-draft). Without it, the
# Advisor reports "brain unavailable" and the Regulatory Watch PR is detection-only.
# Get a key at https://console.anthropic.com/.
#
ANTHROPIC_API_KEY=

# Platform execution cap for the Advisor function, in milliseconds. Netlify
# synchronous functions default to ~10 s, raisable per site only by Netlify
# support. brain-soul derives its own abort budget from this (cap minus 1.5 s of
# headroom for the guards and the response) and clips each mode's token budget to
# what that budget affords, so the function ALWAYS returns its own governed
# answer instead of being killed mid-flight. A killed invocation never returns,
# which means none of the guardrails run — the tipping-off guard, the PII guard,
# the injection and hallucination guards and the audit line all silently do not
# happen. That is why this value must match reality.
#
# Deep mode needs 4096 affordable output tokens to be worth the name, so at the
# ~10 s default it is UNAVAILABLE and degrades to balanced visibly (the response
# carries modeDegraded + a reason, the audit line records it, and the UI shows a
# banner). To enable deep mode: ask Netlify support to raise the site's function
# timeout, then set this to the new cap. No code change needed.
# Default: 10000.
ADVISOR_PLATFORM_CAP_MS=

# ── Edge hardening / CORS (optional) ──

# Canonical production origin the Netlify functions accept browser calls from.
# Defaults to https://hawkeye-sterling-ra.netlify.app. Set this to your custom
# domain (e.g. https://app.example.com) so CORS locks to the real site.
PRIMARY_ORIGIN=

# Comma-separated EXTRA browser origins allowed to call the Netlify functions,
# in addition to PRIMARY_ORIGIN. Same-origin and header-less (server-to-server)
# requests are always allowed; any other browser origin is rejected with 403 and
# receives no Access-Control-Allow-Origin header. Leave blank for primary only.
# Example: https://staging--hawkeye-sterling-ra.netlify.app,https://example.com
ALLOWED_ORIGINS=

# OPTIONAL shared-secret gate (defence in depth, NOT user auth). Leave BLANK for
# the default behaviour (unchanged: header-less server-to-server requests are
# allowed). When set, any request that carries NO browser Origin (curl /
# server-to-server — the path that otherwise bypasses the origin guard) must send
# a matching  X-App-Token: <value>  header; the browser (Origin) path is
# unaffected. A browser cannot hold a secret, so this only hardens the no-Origin
# path — see netlify/functions/_auth.js. If you set this, also add the header to
# any server-side caller (e.g. the verify curls in netlify-deploy.yml).
#
# ⚠ CONFIDENTIAL-DATA ENDPOINTS: asana-mirror (returns the FULL assessment
# register + activity log on an `action:"read"`) and risk-backup (holds the
# risk-data override sheet) are STRICTER — when APP_SHARED_TOKEN is set they
# require X-App-Token on EVERY path, INCLUDING the browser, because the Origin
# header is forgeable and these endpoints return customer data (entity names,
# jurisdictions, outcomes). With APP_SHARED_TOKEN BLANK they are effectively
# public: a deployment that files REAL customer data to Asana MUST set
# APP_SHARED_TOKEN (and fill the same value into the <meta name="hsra-app-token">
# tag in index.html/console.html/advisor.html so the browser sends it).
APP_SHARED_TOKEN=

# Set to 1/true to require X-App-Token on EVERY request to EVERY function
# (including asana-task and the browser path) — the only mode that resists Origin
# forgery. Requires APP_SHARED_TOKEN to be set and the <meta name="hsra-app-token">
# tag to be filled. Optional; default off. See netlify/functions/_auth.js.
APP_STRICT_TOKEN=

# ── Rate limiting (per-IP throttle on the Netlify functions) ──

# Requests/minute/IP allowed on the NORMAL endpoints (asana-task, asana-mirror,
# risk-backup). Over the limit → HTTP 429 with a clear message + Retry-After.
# Defaults to 100 if not set. Optional. See netlify/functions/_ratelimit.js.
RATE_LIMIT_DEFAULT=100

# Requests/minute/IP allowed on the SENSITIVE/COSTLY endpoint (brain-soul, which
# calls the Anthropic API per request). Much stricter. Defaults to 10. Optional.
# NOTE: one deep-mode question on a default-capped site is a guarded
# CONTINUATION of up to 6 requests (see brain-soul.js DEEP_HOP_LIMIT), so the
# default of 10/min affords roughly one deep answer per operator per minute.
# Raise this if operators use deep mode heavily.
RATE_LIMIT_BRAIN_SOUL=10

# archive.org API key for the Regulatory Watch's authenticated Save Page Now
# fallback ("accesskey:secret" from https://archive.org/account/s3.php).
# Optional. Without it, bot-blocked regulator sites (CBUAE, OECD, MoE) depend
# on anonymous SPN, which is rate-limited per IP and unreliable from CI.
# Set as the ARCHIVE_SPN_KEYS repository secret for GitHub Actions.
ARCHIVE_SPN_KEYS=


# ══════════════════════════════════════════════════════════════════════════════
# PYTHON SCREENING ENGINE (screen.py, ai.py, txn_monitor.py, monitoring.py)
# ══════════════════════════════════════════════════════════════════════════════
# The engine reads 77 environment variables; this file used to make 30 of them
# assignable, and the gap included the SANCTIONS COVERAGE FLOORS and the
# HARD-FAIL GATES — the settings that decide whether a degraded screening run
# fails loudly or passes quietly. Everything an operator can legitimately set is
# below. Values shown in (parentheses) are the defaults; every one is optional.
#
# NOT listed here, on purpose: variables that GitHub Actions or an earlier
# workflow step injects, not an operator — GITHUB_ENV, GITHUB_REPOSITORY,
# GITHUB_RUN_ID, GITHUB_SERVER_URL, DATE_ISO, DATE_DISPLAY, TIME_GST,
# SCRIPT_VERSION, the per-list *_HASH values and the UAE_LIST_* review flags.
# Setting those by hand would misreport a run rather than configure it.

# ── Sanctions coverage floors ────────────────────────────────────────────────
# Minimum entry count each list must yield before the run is allowed to call
# itself complete. A source that returns fewer (a truncated download, an HTML
# error page, a changed export format) is a COVERAGE BREACH: the run reports
# DEGRADED and the floor gate fails the job AFTER the report is delivered — it
# never reads as a clean screen. Raise only with evidence; lowering one hides
# exactly the failure it exists to catch.
LIST_FLOOR_OFAC=
LIST_FLOOR_UN=
LIST_FLOOR_EU=
LIST_FLOOR_UK=
LIST_FLOOR_EOCN=
# 0 disables floor ENFORCEMENT (still reported, no longer fails the job).
# Leave unset. This is the switch that turns a loud coverage breach quiet.
LIST_FLOORS_ENFORCE=

# ── Hard-fail gates ──────────────────────────────────────────────────────────
# 1 = a failed report delivery fails the JOB (default). The screen is only
# meaningful if the MLRO actually receives it, so a delivery failure is a
# control failure, not a warning.
DELIVERY_HARD_FAIL=
# 1 = an overdue local-terrorist-list (EOCN) review fails the job. Paired with
# the maximum review age in days (90).
EOCN_REVIEW_HARD_FAIL=
EOCN_REVIEW_MAX_AGE_DAYS=
# Cross-check the in-repo EOCN list against the OpenSanctions mirror (1 = on).
# The mirror alarms on divergence; it is never the screening source itself.
EOCN_MIRROR_CROSSCHECK=

# ── Matching thresholds (Python engine, 0-100 scale) ─────────────────────────
# The JS-side SCREEN_MATCH_THRESHOLD / SCREEN_SHADOW_THRESHOLD above are the
# 0-1 equivalents; these are the names screen.py actually reads, and they were
# described in a comment further up without ever being assignable here.
# Raising any of them weakens screening, so a raise is refused loudly unless
# MATCH_THRESHOLD_ALLOW_RAISE=1 is set as a separate, explicit decision
# (docs/governance/champion-challenger-thresholds.md). Lowering is plain config.
MATCH_THRESHOLD=                    # (85) combined full+core similarity to flag
MATCH_CORE_THRESHOLD=               # (82) distinctive-token similarity required
MATCH_SHORT_ENTRY_THRESHOLD=        # (97) near-exact gate for <6-char names (HAMAS, IRISL)
MATCH_TOKENSET_THRESHOLD=           # (93) strict additive subset/patronymic gate
SHADOW_THRESHOLD=                   # (off) log-only challenger band, must be < MATCH_THRESHOLD
MATCH_THRESHOLD_ALLOW_RAISE=
# 1 = C-side candidate prefilter on (default). 0 disables blocking; results are
# bit-identical either way, so this is a performance switch, not a recall one.
MATCH_BLOCKING=
# Parallel screening workers.
SCREEN_CONCURRENCY=

# ── AI layer (all default OFF; gated on the Anthropic DPA) ───────────────────
LLM_TRIAGE=                         # (0) model-assisted alert triage
REPORT_ALLOW_LLM=                   # (0) allow model text into a filed report
AI_MODEL=                           # (claude-haiku-4-5-20251001) classification calls only

# ── Transaction monitoring (FATF R.16 — engine INERT until a feed exists) ────
# Path to the transaction feed. Unset = the engine loads nothing and says so in
# the report; a CONFIGURED but unparseable feed is a loud DEGRADED state, never
# a quiet "0 transactions" day. See docs/aims/transaction-feed-scoping.md.
TXN_FEED_PATH=
DPMS_CASH_THRESHOLD=                # (55000) AED DPMS cash reporting threshold
CDD_TRIGGER_THRESHOLD=              # (15000) AED occasional-transaction CDD trigger

# ── Adverse media / PEP source controls ──────────────────────────────────────
BING_NEWS=                          # (0) enable Bing News as a third adverse feed
PEP_MIRROR_FALLBACK=                # (1) fall back to the OpenSanctions PEP mirror
ADVERSE_WATCHLIST=                  # extra keyword watchlist file
ADVERSE_EVIDENCE_FILE=              # where adverse-media evidence is written
# Per-source circuit breakers: consecutive failures before the source is
# tripped, minimum seconds between calls, and the backoff ceiling. A tripped
# source degrades the run loudly rather than silently returning no articles.
GNEWS_BREAKER_AFTER=
GNEWS_MIN_INTERVAL=
GNEWS_BACKOFF_CAP=
GDELT_BREAKER_AFTER=
GDELT_MIN_INTERVAL=
BING_BREAKER_AFTER=
BING_MIN_INTERVAL=
BING_BACKOFF_CAP=
PEP_BREAKER_AFTER=
PEP_MIN_INTERVAL=
PEP_BACKOFF_CAP=

# ── Run mode and operational limits ──────────────────────────────────────────
RUN_MODE=                           # (full_batch) full_batch | weekly_adverse
TRIGGER_TYPE=                       # (workflow_dispatch) recorded in the report header
ONBOARDING_WINDOW_HOURS=            # (24) how far back the onboarding screen looks
CASE_SUBTASK_CAP=                   # per-run cap on MLRO case subtasks created
XML_MAX_BYTES=                      # (67108864) refuse oversized XML before parsing (XXE/billion-laughs guard)

# ── Monitoring alarms and state ──────────────────────────────────────────────
ERROR_RATE_ALARM=                   # screening error-rate alarm level
AM_ERROR_RATE_ALARM=                # adverse-media error-rate alarm level
COVERAGE_DROP_PCT=                  # alarm when list coverage drops by this %
LATENCY_ALARM_FACTOR=               # alarm when a run exceeds this × the rolling median
MONITOR_HISTORY_KEEP=               # runs of history retained
METRICS_MAX_AGE_DAYS=               # age at which the metrics snapshot reads stale
METRICS_STATE_PATH=                 # override the metrics state file location
COVERAGE_STATE_PATH=                # override the coverage state file location
