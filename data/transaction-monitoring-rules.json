    },
    {
      "id": "TXN-INVOICE-001",
      "engine_rule": "INVOICE_MISMATCH",
      "typology": "trade_document_mismatch",
      "severity": "HIGH",
      "detection": "automated",
      "source_red_flags": [
        "RF-TXN-27",
        "RF-TXN-29",
        "RFC-126",
        "RFC-127",
        "RFC-128",
        "RFC-129",
        "RFC-138",
        "RFC-139",
        "RFC-140",
        "RFC-148",
        "RFC-149",
        "RFC-150"
      ],
      "description": "Structured invoice, shipment, weight, purity, quantity, or value reconciliation is explicitly marked as materially mismatched.",
      "required_fields": [
