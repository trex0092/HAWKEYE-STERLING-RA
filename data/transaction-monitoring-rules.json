{
  "_README": "Machine-readable transaction-monitoring rule registry. Rules are alerts for review, not automatic STR/SAR filing decisions. detection=automated means the rule can be evaluated from explicit structured transaction fields. detection=review means human or external evidence is required. The source_red_flags values preserve links to the source red-flag libraries.",
  "version": 1,
  "decision_authority": "Compliance Officer / MLRO",
  "rules": [
    {
      "id": "TXN-THRESHOLD-001",
      "engine_rule": "THRESHOLD",
      "typology": "threshold_reporting",
      "severity": "HIGH",
      "detection": "automated",
      "source_red_flags": [
        "RF-TXN-20"
      ],
      "description": "Cash transaction at or above the configured DPMS cash reporting threshold.",
      "required_fields": [
        "amount",
        "method"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-STRUCT-001",
      "engine_rule": "STRUCTURING",
      "typology": "structuring",
      "severity": "CRITICAL",
      "detection": "automated",
      "source_red_flags": [
        "RF-TXN-20",
        "RFC-063",
        "RFC-064",
        "RFC-065",
        "RFC-066",
        "RFC-067",
        "RFC-070",
        "RFC-071"
      ],
      "description": "Repeated or fragmented transactions just below the reporting threshold within the configured monitoring window.",
      "required_fields": [
        "customer",
        "date",
        "amount",
        "method"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-VELOCITY-001",
      "engine_rule": "VELOCITY",
      "typology": "profile_deviation",
      "severity": "MEDIUM",
      "detection": "automated",
      "source_red_flags": [
        "RFC-051",
        "RFC-052",
        "RFC-053"
      ],
      "description": "Transaction-day volume materially exceeds the customer's observed baseline.",
      "required_fields": [
        "customer",
        "date",
        "amount"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-GEO-001",
      "engine_rule": "HIGH_RISK_GEO",
      "typology": "geographic_risk",
      "severity": "risk_based",
      "detection": "automated",
      "source_red_flags": [
        "RFC-231",
        "RFC-232",
        "RFC-238"
      ],
      "description": "Counterparty jurisdiction is in the maintained higher-risk jurisdiction table.",
      "required_fields": [
        "counterparty_country"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-PASS-001",
      "engine_rule": "PASSTHROUGH",
      "typology": "layering",
      "severity": "HIGH",
      "detection": "automated",
      "source_red_flags": [
        "RF-TXN-21",
        "RF-TXN-22"
      ],
      "description": "Similar value received and transferred onward within a short period.",
      "required_fields": [
        "customer",
        "date",
        "amount",
        "direction"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-ROUND-001",
      "engine_rule": "ROUND_AMOUNT",
      "typology": "cash_pattern",
      "severity": "MEDIUM",
      "detection": "automated",
      "source_red_flags": [
        "RFC-073",
        "RFC-076",
        "RFC-077",
        "RFC-078"
      ],
      "description": "Repeated exact-round cash transactions inconsistent with metal-rate-priced activity.",
      "required_fields": [
        "amount",
        "method"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-3P-001",
      "engine_rule": "THIRD_PARTY_PAYMENT",
      "typology": "third_party_payment",
      "severity": "HIGH",
      "detection": "automated",
      "source_red_flags": [
        "RF-TXN-14",
        "RFC-083",
        "RFC-084",
        "RFC-085",
        "RFC-086",
        "RFC-087",
        "RFC-088",
        "RFC-089"
      ],
      "description": "Payment originates from or is directed to a party explicitly recorded as unrelated to the transaction.",
      "required_fields": [
        "third_party_payment",
        "third_party_relationship"
      ],
      "automatic_filing": false
    },
    {
      "id": "TXN-REFUND-001",
      "engine_rule": "REFUND_DIVERSION",
      "typology": "refund_diversion",
      "severity": "HIGH",
      "detection": "automated",
      "source_red_flags": [
        "RFC-105",
        "RFC-106",
        "RFC-107",
        "RFC-108",
        "RFC-109"
      ],
      "description": "Refund is directed to an account different from the original funding account without an explicitly documented legitimate reason.",
      "required_fields": [
        "transaction_type",
        "funding_account",
        "refund_account",
        "refund_reason_documented"
      ],
      "automatic_filing": false
    },
    {
