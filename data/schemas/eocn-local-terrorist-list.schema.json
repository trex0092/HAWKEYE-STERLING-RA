{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hawkeye:data/schemas/eocn-local-terrorist-list.schema.json",
  "title": "UAE EOCN Local Terrorist List (in-repo copy)",
  "description": "Shape of data/eocn-local-terrorist-list.json. An entry is a plain name or {name, aliases}. count must equal the number of entries (checked natively by test/data_schema_test.py). lastReviewed gates the daily screen, so it must be an ISO date.",
  "x-hawkeye-validates": [
    "data/eocn-local-terrorist-list.json"
  ],
  "type": "object",
  "required": [
    "_README",
    "source",
    "list",
    "lastReviewed",
    "populated",
    "entries",
    "count",
    "lastReviewedEvidence"
  ],
  "properties": {
    "_README": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "list": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "populated": {
      "type": "boolean"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "lastReviewedEvidence": {
      "type": "string",
      "minLength": 20
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
