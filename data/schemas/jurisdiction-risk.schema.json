{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hawkeye:data/schemas/jurisdiction-risk.schema.json",
  "title": "FATF jurisdiction risk lists used by KYC scoring",
  "x-hawkeye-validates": [
    "data/jurisdiction-risk.json"
  ],
  "type": "object",
  "required": [
    "_meta",
    "grey",
    "high"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "purpose",
        "source_of_truth",
        "last_reviewed"
      ],
      "properties": {
        "last_reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "grey": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "high": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false
}
