{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hawkeye:data/schemas/demonyms.schema.json",
  "title": "Generated demonym table",
  "description": "Shape of data/demonyms.json (generated by scripts/demonyms-from-countries.mjs). Validated only when the file exists.",
  "x-hawkeye-validates": [
    "data/demonyms.json"
  ],
  "x-hawkeye-optional": true,
  "type": "object",
  "required": [
    "_meta",
    "demonyms",
    "ambiguous"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "required": [
        "source",
        "commit",
        "sourceSha256",
        "licence",
        "attribution",
        "generatedBy"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "licence": {
          "const": "ODbL-1.0"
        }
      }
    },
    "demonyms": {
      "type": "object",
      "minProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z' -]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "ambiguous": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
